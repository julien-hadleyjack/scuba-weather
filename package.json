    "@tsconfig/svelte": "^5.0.8",
    "@types/d3-shape": "^3.2.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.5",
